# Binance API (opcional — la API publica no requiere autenticacion)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

LOG_LEVEL=INFO
API_PORT=8000

# Ruta de la base de datos SQLite (relativa a backend/ por defecto)
# DB_PATH=data/sacbinance.db

# --- CORS ---
# El backend sirve frontend/dist en el MISMO puerto, asi que en produccion no
# hace falta tocar esto: el navegador no manda preflight para mismo origen.
# Solo si abris el dashboard desde otro origen (dev con Vite en 5173, o un
# dominio distinto al del backend) hay que listarlo aqui, separado por comas.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Velas HTF en formacion ---
# Incluye la vela 15m/1h en curso en el analisis (es lo que dibuja Binance).
# Poner en false si el servidor va justo de CPU.
# HTF_LIVE_ENABLED=true
# HTF_LIVE_TFS=15m,1h

# --- Throttling del analisis pesado ---
# Cada cuantos segundos se recalcula S/R + consolidacion + compresion + grind
# para los pares que NO son interesantes. Los interesantes van sin throttle.
# HEAVY_ANALYSIS_INTERVAL=300
