[Unit]
Description=SACBinance - IA en sombra (Kronos + GPT-6 Luna/Sol), solo lectura
After=network-online.target sacbinance.service
Wants=network-online.target

[Service]
Type=simple
User=flox
WorkingDirectory=/home/flox/sacbinance/ia_sombra
ExecStart=/home/flox/sacbinance/ia_sombra/venv/bin/python -m sac_ia servir
Restart=on-failure
RestartSec=30

# SAC tiene prioridad. Este servicio cede CPU, tiene techo de memoria y, si lo
# pasa, el que muere es el, no SAC.
Nice=10
CPUQuota=150%
MemoryHigh=1536M
MemoryMax=2G
Environment=OMP_NUM_THREADS=2
Environment=HF_HUB_OFFLINE=1

[Install]
WantedBy=multi-user.target
